<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.btl.team10.client.controller.SellerDashboardController"
            stylesheets="@../styles/app.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header">

            <Label text="Quản lý vật phẩm"
                   style="-fx-text-fill: #14253f; -fx-font-size: 23px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Tải lại vật phẩm" onAction="#onRefreshItems"
                    styleClass="button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED">
            <VBox spacing="14">
                <padding><Insets top="16" right="20" bottom="20" left="20"/></padding>

                <Label fx:id="feedbackLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
                       style="-fx-padding: 10 14; -fx-background-radius: 6; -fx-font-weight: bold;"/>

                <!-- Bảng danh sách vật phẩm hiện có -->
                <VBox spacing="8"
                      styleClass="panel">
                    <Label text="Bộ sưu tập của bạn · Chọn một dòng để chỉnh sửa hoặc mở phiên"
                           style="-fx-font-weight: bold; -fx-text-fill: #172b48;"/>
                    <TableView fx:id="itemTable" prefHeight="210">
                        <columns>
                            <TableColumn fx:id="itemIdCol" text="ID Vật phẩm" prefWidth="95"/>
                            <TableColumn fx:id="itemNameCol" text="Tên vật phẩm" prefWidth="210"/>
                            <TableColumn fx:id="itemTypeCol" text="Phân loại" prefWidth="130"/>
                            <TableColumn fx:id="itemImageCol" text="Ảnh sân khấu" prefWidth="105"/>
                            <TableColumn fx:id="itemDescCol" text="Mô tả" prefWidth="240"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Hai biểu mẫu song song: Quản lý Vật phẩm & Mở Phiên Đấu Giá -->
                <VBox spacing="18">
                    <!-- Cột trái: Tạo / Sửa / Xóa vật phẩm -->
                    <VBox spacing="10"
                          styleClass="panel">
                        <Label text="Thông tin vật phẩm"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #172b48;"/>
                        <Separator/>

                        <HBox spacing="12" alignment="TOP_LEFT">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Tên vật phẩm:" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                                <TextField fx:id="itemNameField" promptText="Ví dụ: Cúp Vô Địch UEFA Euro"/>

                                <Label text="Phân loại:" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                                <TextField fx:id="itemTypeField" promptText="CARD, FIGURE, POSTER"/>
                            </VBox>

                            <VBox spacing="6" alignment="CENTER">
                                <StackPane prefWidth="112" prefHeight="112"
                                           style="-fx-background-color: #1e293b; -fx-border-color: #f1c40f; -fx-border-radius: 6; -fx-background-radius: 6;">
                                    <Label fx:id="previewPlaceholderLabel" text="Xem trước"
                                           style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;"/>
                                    <ImageView fx:id="itemPreviewImageView" fitWidth="102" fitHeight="102" preserveRatio="true"/>
                                </StackPane>
                                <HBox spacing="4">
                                    <Button fx:id="chooseImageBtn" text="Chọn file ảnh" onAction="#onChooseImage"
                                            styleClass="button"/>
                                    <Button fx:id="clearImageBtn" text="Bỏ ảnh" onAction="#onClearImage"
                                            styleClass="button"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Nút chọn nhanh mẫu vật phẩm Gala -->
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Mẫu có sẵn:" style="-fx-font-size: 11px; -fx-text-fill: #75849a;"/>
                            <Button text="Cúp Euro" onAction="#onPresetEuro"
                                    style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Button text="Quả Bóng Vàng" onAction="#onPresetBallonDor"
                                    style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Button text="Áo Messi GOAT" onAction="#onPresetMessiGoat"
                                    style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>

                        <Label fx:id="imageFileLabel" text="PNG hoặc JPG · Tối đa 512 KB"
                               style="-fx-font-size: 11px; -fx-text-fill: #75849a;"/>

                        <Label text="Mô tả chi tiết:" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                        <TextArea fx:id="itemDescArea" promptText="Nhập mô tả tình trạng và thuộc tính vật phẩm..."
                                  prefRowCount="2" wrapText="true"/>

                        <HBox spacing="8">
                            <Button fx:id="createItemBtn" text="Tạo vật phẩm" onAction="#onCreateItem"
                                    styleClass="button, primary"/>
                            <Button fx:id="updateItemBtn" text="Cập nhật" onAction="#onUpdateItem" disable="true"
                                    styleClass="button, primary"/>
                            <Button fx:id="deleteItemBtn" text="Xóa" onAction="#onDeleteItem" disable="true"
                                    styleClass="button, danger"/>
                            <Button text="Xóa trắng form" onAction="#onClearForm"
                                    styleClass="button"/>
                        </HBox>
                    </VBox>

                    <!-- Cột phải: Mở phiên đấu giá mới -->
                    <VBox spacing="10" maxWidth="Infinity"
                          styleClass="panel">
                        <Label text="Mở phiên đấu giá"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #172b48;"/>
                        <Separator/>

                        <Label text="ID vật phẩm đem đấu giá:" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                        <TextField fx:id="auctionItemIdField" promptText="Chọn dòng vật phẩm ở bảng trên hoặc nhập ID"/>

                        <Label text="Giá khởi điểm (cents):" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                        <TextField fx:id="startPriceField" promptText="Ví dụ: 10000"/>

                        <Label text="Bước giá tối thiểu (cents):" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                        <TextField fx:id="minIncrementField" promptText="Ví dụ: 500"/>

                        <Label text="Thời lượng phiên (giờ):" style="-fx-font-size: 12px; -fx-text-fill: #68778e;"/>
                        <TextField fx:id="durationHoursField" text="1" promptText="Ví dụ: 1"/>

                        <Button fx:id="createAuctionBtn" text="Mở phiên đấu giá ngay" onAction="#onCreateAuction"
                                maxWidth="Infinity" prefHeight="38"
                                styleClass="button, gold"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
