<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.btl.team10.client.controller.MainShellController"
            prefWidth="1120.0" prefHeight="700.0">

    <!-- Thanh điều hướng tối giản bên trái -->
    <left>
        <VBox fx:id="sidebarBox" spacing="16" prefWidth="210.0"
              style="-fx-background-color: #111627; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 1 0 0;">
            <padding><Insets top="20" right="14" bottom="18" left="14"/></padding>

            <!-- Logo / Tên ứng dụng tối giản -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Circle radius="4.5" fill="#facc15"/>
                <Label text="GALA AUCTION"
                       style="-fx-text-fill: #f8fafc; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Khối dự phòng -->
            <VBox fx:id="guestInfoBox" spacing="4" visible="false" managed="false">
                <Label text="Chưa đăng nhập" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Khu vực tài khoản, ví & điều hướng -->
            <VBox fx:id="sessionPanel" spacing="16" visible="false" managed="false" VBox.vgrow="ALWAYS">

                <!-- Thẻ tài khoản & số dư gọn nhẹ -->
                <VBox spacing="10"
                      style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12; -fx-padding: 12;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="userAccountLabel" text="Tài khoản" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                               style="-fx-text-fill: #f8fafc; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="userRoleBadge" text="BIDDER"
                               style="-fx-background-color: rgba(56,189,248,0.16); -fx-text-fill: #7dd3fc; -fx-padding: 2 7; -fx-background-radius: 6; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    </HBox>

                    <VBox spacing="3"
                          style="-fx-background-color: rgba(15,23,42,0.55); -fx-padding: 8 10; -fx-background-radius: 8;">
                        <Label text="SỐ DƯ KHẢ DỤNG" style="-fx-text-fill: #64748b; -fx-font-size: 9.5px; -fx-font-weight: bold;"/>
                        <Label fx:id="balanceLabel" text="0 c"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="frozenLabel" text="Đóng băng: 0 c"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                    </VBox>
                </VBox>

                <!-- Danh sách điều hướng phẳng -->
                <VBox spacing="6">
                    <Button fx:id="navAuctionsBtn" text="Phiên đấu giá" onAction="#onNavigateAuctions"
                            maxWidth="Infinity" alignment="CENTER_LEFT" prefHeight="36"
                            style="-fx-background-color: rgba(250,204,21,0.12); -fx-text-fill: #fde047; -fx-border-color: #facc15; -fx-border-width: 0 0 0 3; -fx-background-radius: 7; -fx-padding: 0 12; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <Button fx:id="navSellerBtn" text="Quản lý vật phẩm" onAction="#onNavigateSeller"
                            maxWidth="Infinity" alignment="CENTER_LEFT" prefHeight="36" visible="false" managed="false"
                            style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 7; -fx-padding: 0 12; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <Button fx:id="navAdminBtn" text="Quản trị hệ thống" onAction="#onNavigateAdmin"
                            maxWidth="Infinity" alignment="CENTER_LEFT" prefHeight="36" visible="false" managed="false"
                            style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 7; -fx-padding: 0 12; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label fx:id="shellNoticeLabel" text="" wrapText="true" visible="false" managed="false"
                       style="-fx-background-color: rgba(217,119,6,0.2); -fx-text-fill: #fcd34d; -fx-padding: 8 10; -fx-background-radius: 8; -fx-font-size: 11px;"/>

                <!-- Nút đăng xuất tinh gọn -->
                <Button fx:id="logoutBtn" text="Đăng xuất" onAction="#onLogout"
                        maxWidth="Infinity" prefHeight="34"
                        style="-fx-background-color: rgba(239,68,68,0.12); -fx-text-fill: #fca5a5; -fx-border-color: rgba(239,68,68,0.28); -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Khu vực hiển thị nội dung chính -->
    <center>
        <StackPane fx:id="mainContentArea" style="-fx-background-color: #0e1324;"/>
    </center>

</BorderPane>