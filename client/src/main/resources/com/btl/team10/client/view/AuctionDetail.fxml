<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.btl.team10.client.controller.AuctionDetailController"
            stylesheets="@../css/gala-detail.css"
            style="-fx-background-color: #fff5f8;">

    <!-- Header gọn nhẹ: Nút quay lại + Tiêu đề phiên + Anti-Snipe + Trạng thái -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #fffafc; -fx-border-color: #fbcfe8; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Button text="← Danh sách" onAction="#handleBack" prefHeight="32"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #831843; -fx-border-color: #f9a8d4; -fx-border-radius: 8; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Label fx:id="auctionTitleLabel" text="Phiên đấu giá #--"
                   style="-fx-text-fill: #4a0e2e; -fx-font-size: 17px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="extensionCountLabel" text="Anti-Snipe: 0 lần gia hạn"
                   style="-fx-background-color: #fdf2f8; -fx-text-fill: #9d174d; -fx-padding: 4 11; -fx-background-radius: 12; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
            <Label fx:id="statusBadgeLabel" text="RUNNING"
                   style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-padding: 4 11; -fx-background-radius: 12; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Nội dung chính -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" styleClass="gala-scroll">
            <VBox spacing="14">
                <padding><Insets top="14" right="20" bottom="20" left="20"/></padding>

                <!-- Banner thông báo Realtime / Lỗi -->
                <Label fx:id="alertBannerLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
                       style="-fx-padding: 9 14; -fx-background-radius: 9; -fx-font-weight: bold;"/>

                <!-- Banner kết quả khi đóng phiên (FINISHED / PAID / CANCELLED) -->
                <HBox fx:id="winnerBannerBox" alignment="CENTER_LEFT" spacing="14" visible="false" managed="false"
                      style="-fx-background-color: #fdf2f8; -fx-border-color: #f472b6; -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 11 16; -fx-background-radius: 12;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="winnerTitleLabel" wrapText="true" text="Kết quả phiên đấu giá"
                               style="-fx-text-fill: #831843; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="settlementStatusLabel" wrapText="true" text="Đang chờ quyết toán..."
                               style="-fx-text-fill: #6b2146; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <!-- Bố cục 2 cột: Trái (Sân khấu + Biểu đồ + Lịch sử) | Phải (Thông tin + Đặt giá + Auto-Bid) -->
                <HBox spacing="16" alignment="TOP_LEFT">

                    <!-- CỘT TRÁI: Sân khấu 2D gọn nhẹ + Biểu đồ & Lịch sử đặt giá -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS" minWidth="420">

                        <!-- Sân khấu Gala 2D (giảm chiều cao xuống 200px, viền mảnh, không đổ bóng) -->
                        <StackPane fx:id="galaStageRoot" VBox.vgrow="NEVER" minWidth="0" minHeight="200" prefHeight="200" maxHeight="200"
                                   style="-fx-background-color: #fdf2f8; -fx-background-radius: 14; -fx-border-color: #f5d0e3; -fx-border-width: 1; -fx-border-radius: 14;">
                            <children>
                                <Pane fx:id="backdropPane" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0" mouseTransparent="true">
                                    <children>
                                        <ImageView fx:id="stageBackdropView" preserveRatio="false" opacity="0.88"/>
                                    </children>
                                </Pane>

                                <Region fx:id="stageAtmosphereOverlay" mouseTransparent="true"
                                        style="-fx-background-color: rgba(255, 245, 248, 0.16); -fx-background-radius: 13;"/>

                                <HBox alignment="BOTTOM_CENTER" spacing="12" minHeight="0" prefHeight="188" maxHeight="188">
                                    <padding><Insets top="6" right="14" bottom="4" left="14"/></padding>

                                    <!-- Bục + Gấu bông -->
                                    <VBox alignment="BOTTOM_CENTER" prefWidth="128" minHeight="0" prefHeight="186" maxHeight="186" spacing="-8">
                                        <StackPane fx:id="itemFloatingBox" prefWidth="104" prefHeight="104" maxHeight="104">
                                            <Circle radius="42" fill="rgba(255, 255, 255, 0.72)"/>
                                            <ImageView fx:id="itemStageImageView" fitWidth="94" fitHeight="94" preserveRatio="true"/>
                                            <VBox fx:id="defaultArtifactBox" alignment="CENTER" spacing="2"
                                                  prefWidth="88" prefHeight="88" visible="false" managed="false"
                                                  style="-fx-background-color: rgba(255,245,248,0.94); -fx-background-radius: 12; -fx-border-color: #f472b6; -fx-border-radius: 12; -fx-border-width: 1;">
                                                <Label fx:id="defaultArtifactIconLabel" text="GẤU BÔNG"
                                                       style="-fx-text-fill: #be185d; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                                                <Label text="ĐANG LÊN SÀN"
                                                       style="-fx-text-fill: #4a0e2e; -fx-font-size: 9px;"/>
                                            </VBox>
                                        </StackPane>

                                        <StackPane alignment="BOTTOM_CENTER" prefWidth="136" prefHeight="76" maxHeight="76">
                                            <ImageView fx:id="pedestalImageView" fitWidth="128" fitHeight="74" preserveRatio="true"/>
                                            <VBox fx:id="fallbackPedestalBox" alignment="CENTER" prefWidth="122" prefHeight="52"
                                                  visible="false" managed="false"
                                                  style="-fx-background-color: #db2777; -fx-background-radius: 8;">
                                                <Label text="PLUSHIE GALA"
                                                       style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 10px;"/>
                                            </VBox>
                                        </StackPane>
                                    </VBox>

                                    <!-- Bong bóng thoại MC -->
                                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" minWidth="0" minHeight="0" prefHeight="186" maxHeight="186">
                                        <VBox fx:id="mcSpeechBubble" spacing="5" maxWidth="Infinity"
                                              style="-fx-background-color: rgba(255, 250, 252, 0.96); -fx-padding: 10 14; -fx-background-radius: 12; -fx-border-color: #f472b6; -fx-border-width: 1; -fx-border-radius: 12;">
                                            <HBox alignment="CENTER_LEFT" spacing="8">
                                                <Label text="MC Ronaldo"
                                                       style="-fx-background-color: #fce7f3; -fx-text-fill: #be185d; -fx-padding: 2 8; -fx-background-radius: 6; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>
                                                <Label fx:id="mcMoodLabel" text="Chào sàn"
                                                       style="-fx-text-fill: #834463; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                            </HBox>
                                            <Label fx:id="mcDialogueLabel"
                                                   text="Xin chào các nhà sưu tầm! Bé gấu bông đã lên bục, mời cả nhà phát giá!"
                                                   wrapText="true"
                                                   style="-fx-text-fill: #3b0d24; -fx-font-size: 12.5px; -fx-font-weight: bold;"/>
                                        </VBox>
                                    </VBox>

                                    <!-- MC Ronaldo -->
                                    <StackPane fx:id="mcActorBox" prefWidth="124" minHeight="0" prefHeight="186" maxHeight="186" alignment="BOTTOM_CENTER">
                                        <ImageView fx:id="mcImageView" fitWidth="118" fitHeight="180" preserveRatio="true"/>
                                    </StackPane>
                                </HBox>

                                <Pane fx:id="confettiLayer" mouseTransparent="true"/>
                            </children>
                        </StackPane>

                        <!-- Khối phân tích hợp nhất: Biểu đồ trên, Lịch sử đặt giá full-width bên dưới -->
                        <VBox spacing="14"
                              style="-fx-background-color: #ffffff; -fx-padding: 14 16; -fx-background-radius: 14; -fx-border-color: #f5d0e3; -fx-border-radius: 14;">

                            <VBox spacing="6">
                                <Label text="Biểu đồ biến động giá"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a0e2e;"/>
                                <LineChart prefHeight="210" fx:id="bidHistoryChart" styleClass="gala-chart"
                                           animated="false" legendVisible="false">
                                    <xAxis>
                                        <CategoryAxis fx:id="chartTimeAxis" label="Thời gian"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="chartPriceAxis" label="Giá (cents)" forceZeroInRange="false"/>
                                    </yAxis>
                                </LineChart>
                            </VBox>

                            <Separator/>

                            <VBox spacing="6">
                                <Label text="Lịch sử đặt giá"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a0e2e;"/>
                                <TableView prefHeight="200" fx:id="bidHistoryTable" styleClass="gala-table">
                                    <columns>
                                        <TableColumn fx:id="bidderCol" text="Bidder" prefWidth="95"/>
                                        <TableColumn fx:id="amountCol" text="Số tiền" prefWidth="140"/>
                                        <TableColumn fx:id="timeCol" text="Thời gian" prefWidth="125"/>
                                        <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="150"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- CỘT PHẢI: Thông tin vật phẩm + Đặt giá thủ công + Auto-Bid -->
                    <VBox spacing="14" prefWidth="356" minWidth="340" maxWidth="380">

                        <!-- Thẻ 1: Thông tin vật phẩm, Giá & Đặt giá thủ công (phẳng, không hộp con lồng nhau) -->
                        <VBox spacing="12"
                              style="-fx-background-color: #ffffff; -fx-padding: 16; -fx-background-radius: 14; -fx-border-color: #f5d0e3; -fx-border-radius: 14;">

                            <VBox spacing="6">
                                <Label fx:id="itemNameLabel" wrapText="true" text="Đang tải thông tin vật phẩm..."
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d0a1e;"/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label fx:id="leadStatusLabel" text="CHƯA THAM GIA ĐẶT GIÁ"
                                           style="-fx-background-color: #834463; -fx-text-fill: white; -fx-padding: 3 9; -fx-background-radius: 6; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>
                                </HBox>
                                <Label fx:id="itemDescLabel" text="" wrapText="true"
                                       style="-fx-text-fill: #834463; -fx-font-size: 12px;"/>
                            </VBox>

                            <Separator/>

                            <!-- Giá hiện tại nổi bật + 2 thông số phụ gọn nhẹ -->
                            <VBox spacing="2">
                                <Label text="Giá hiện tại" style="-fx-font-size: 11px; -fx-text-fill: #834463;"/>
                                <Label fx:id="currentPriceLabel" text="0 cents"
                                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #db2777;"/>
                            </VBox>

                            <HBox spacing="16">
                                <VBox spacing="1" HBox.hgrow="ALWAYS">
                                    <Label text="Bước giá tối thiểu" style="-fx-font-size: 11px; -fx-text-fill: #834463;"/>
                                    <Label fx:id="minIncrementLabel" text="+0 cents"
                                           style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #3b0d24;"/>
                                </VBox>
                                <VBox spacing="1" HBox.hgrow="ALWAYS">
                                    <Label text="Đặt hợp lệ tối thiểu" style="-fx-font-size: 11px; -fx-text-fill: #834463;"/>
                                    <Label fx:id="minNextBidLabel" text="0 cents"
                                           style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
                                </VBox>
                            </HBox>

                            <Separator/>

                            <!-- Đồng hồ đếm ngược 1 dòng gọn -->
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Thời gian còn lại"
                                       style="-fx-font-size: 11.5px; -fx-text-fill: #834463;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="countdownLabel" text="--:--:--"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #be185d;"/>
                            </HBox>

                            <!-- Ô nhập giá + Nút điền nhanh không bị cắt chữ -->
                            <HBox spacing="8">
                                <TextField fx:id="bidAmountField" promptText="Nhập số tiền (cents)" HBox.hgrow="ALWAYS" prefHeight="36"
                                           style="-fx-background-color: #fffafc; -fx-text-fill: #3b0d24; -fx-prompt-text-fill: #b47b96; -fx-border-color: #f9a8d4; -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 0 10;"/>
                                <Button fx:id="quickFillButton" text="Tối thiểu" onAction="#handleFillMinBid"
                                        prefHeight="36" minWidth="84"
                                        style="-fx-background-color: #fdf2f8; -fx-text-fill: #9d174d; -fx-border-color: #f9a8d4; -fx-border-radius: 9; -fx-background-radius: 9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            </HBox>

                            <Button fx:id="placeBidButton" text="Đặt giá ngay →" onAction="#handlePlaceBid"
                                    maxWidth="Infinity" prefHeight="38"
                                    style="-fx-background-color: #db2777; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Thẻ 2: Đặt giá tự động (Auto-Bid) -->
                        <VBox spacing="10"
                              style="-fx-background-color: #ffffff; -fx-padding: 16; -fx-background-radius: 14; -fx-border-color: #f5d0e3; -fx-border-radius: 14;">
                            <VBox spacing="2">
                                <Label text="Đặt giá tự động (Auto-Bid)"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2d0a1e;"/>
                                <Label fx:id="autoBidStatusLabel" wrapText="true" text="Chưa kích hoạt trên phiên này"
                                       style="-fx-text-fill: #834463; -fx-font-size: 11.5px;"/>
                            </VBox>

                            <HBox spacing="8">
                                <TextField fx:id="autoBidMaxField" promptText="Giá trần (cents)" HBox.hgrow="ALWAYS" prefHeight="35"
                                           style="-fx-background-color: #fffafc; -fx-text-fill: #3b0d24; -fx-prompt-text-fill: #b47b96; -fx-border-color: #f9a8d4; -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 0 10;"/>
                                <TextField fx:id="autoBidIncrementField" promptText="Bước tự động" prefWidth="122" prefHeight="35"
                                           style="-fx-background-color: #fffafc; -fx-text-fill: #3b0d24; -fx-prompt-text-fill: #b47b96; -fx-border-color: #f9a8d4; -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 0 10;"/>
                            </HBox>

                            <HBox spacing="8">
                                <Button fx:id="setAutoBidButton" text="Kích hoạt Auto-Bid" onAction="#handleSetAutoBid"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35"
                                        style="-fx-background-color: #ec4899; -fx-text-fill: #ffffff; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;"/>
                                <Button fx:id="cancelAutoBidButton" text="Tắt" onAction="#handleCancelAutoBid"
                                        prefHeight="35" minWidth="64"
                                        style="-fx-background-color: #fdf2f8; -fx-text-fill: #831843; -fx-border-color: #f9a8d4; -fx-border-radius: 9; -fx-background-radius: 9; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            </HBox>

                            <Label text="Tự động nâng giá theo bước cài đặt cho đến khi chạm mức trần."
                                   wrapText="true" style="-fx-text-fill: #9d5c7c; -fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>