<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.btl.team10.client.controller.AuctionListController"
            stylesheets="@../styles/app.css">

    <!-- Thanh tiêu đề Khán phòng Gala -->
    <top><VBox spacing="18" styleClass="page-header">
      <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="KHÁM PHÁ BỘ SƯU TẬP" styleClass="eyebrow"/><Label text="Phiên đấu giá" styleClass="page-title"/></VBox>
        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="pill, success-pill"><Circle fx:id="liveHeaderDot" radius="3" fill="#267457"/><Label text="Cập nhật trực tiếp"/></HBox>
        <Label fx:id="totalCountBadge" text="0 phiên" styleClass="pill"/>
      </HBox>
      <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="metric"><Label text="ĐANG DIỄN RA" styleClass="eyebrow"/><Label fx:id="kpiLiveLabel" text="0 phiên" styleClass="metric-value"/></VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="metric"><Label text="GIÁ TRỊ ĐANG HIỂN THỊ" styleClass="eyebrow"/><Label fx:id="kpiVolumeLabel" text="0 cents" styleClass="metric-value"/></VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="metric"><Label text="SỐ PHIÊN TÌM THẤY" styleClass="eyebrow"/><Label fx:id="kpiTotalLabel" text="0 phiên" styleClass="metric-value"/></VBox>
      </HBox>
      <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo tên vật phẩm hoặc mã phiên…" HBox.hgrow="ALWAYS" minWidth="100"/>
        <ComboBox fx:id="statusFilterBox" prefWidth="140" onAction="#onFilterChanged"/>
        <Button fx:id="toggleLayoutBtn" text="Dạng bảng" onAction="#onToggleLayout"/>
        <Button fx:id="refreshBtn" text="Làm mới" onAction="#onRefresh" styleClass="button, primary"/>
      </HBox>
    </VBox></top>

    <!-- Khu vực danh sách thẻ / bảng -->
    <center>
        <VBox spacing="16" styleClass="page-body">


            <Label fx:id="statusMessageLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
                   style="-fx-padding: 10 14; -fx-background-radius: 8; -fx-font-weight: bold;"/>

            <StackPane VBox.vgrow="ALWAYS">
                <!-- Chế độ 1: Lưới thẻ trưng bày Gala (Mặc định) -->
                <ScrollPane fx:id="cardScrollPane" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <FlowPane fx:id="cardGridPane" hgap="16" vgap="16" prefWrapLength="800" minWidth="0">
                        <padding><Insets top="4" right="4" bottom="8" left="4"/></padding>
                    </FlowPane>
                </ScrollPane>

                <!-- Chế độ 2: Bảng chi tiết (ẩn mặc định, bật bằng nút 'Dạng bảng') -->
                <TableView fx:id="auctionTable" visible="false" managed="false"
                           style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10;">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID Phiên" prefWidth="80"/>
                        <TableColumn fx:id="itemCol" text="Vật phẩm" prefWidth="150"/>
                        <TableColumn fx:id="startPriceCol" text="Giá khởi điểm" prefWidth="120"/>
                        <TableColumn fx:id="currentPriceCol" text="Giá hiện tại" prefWidth="120"/>
                        <TableColumn fx:id="incrementCol" text="Bước giá" prefWidth="105"/>
                        <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="115"/>
                        <TableColumn fx:id="endAtCol" text="Thời điểm kết thúc" prefWidth="165"/>
                    </columns>
                </TableView>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Chọn vật phẩm để xem chi tiết và tham gia."
                       style="-fx-text-fill: #475569; -fx-font-size: 12px;" HBox.hgrow="ALWAYS"/>
                <Button fx:id="cancelAuctionBtn" text="Hủy phiên đã chọn" onAction="#onCancelAuction"
                        visible="false" managed="false" prefHeight="36"
                        styleClass="button, danger"/>
                <Button fx:id="openDetailBtn" text="Xem chi tiết →" onAction="#onOpenDetail"
                        prefHeight="36"
                        styleClass="button, primary"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
