<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="loginRoot" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.btl.team10.client.controller.LoginController"
           style="-fx-background-color: linear-gradient(to bottom right, #16182c, #24294a);">

    <!-- Lớp 1: Ảnh nền sân khấu Gala co giãn vừa khít cửa sổ (không gây tràn khung) -->
    <Pane fx:id="bgPane" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0" mouseTransparent="true">
        <children>
            <ImageView fx:id="loginBgView" preserveRatio="false"/>
        </children>
    </Pane>

    <!-- Lớp 2: Phủ tối nhẹ để làm nổi bật khung thẻ đăng nhập ở giữa -->
    <Region mouseTransparent="true"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 75%, rgba(10,14,28,0.18), rgba(10,14,28,0.52));"/>

    <!-- Lớp 3: Thẻ Đăng nhập / Đăng ký trung tâm -->
    <StackPane>
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <HBox maxWidth="720" maxHeight="530"
              style="-fx-background-color: transparent; -fx-background-radius: 16; -fx-border-color: rgba(241, 196, 15, 0.55); -fx-border-width: 1.5; -fx-border-radius: 16;">
            <effect>
                <DropShadow color="rgba(0, 0, 0, 0.55)" radius="28" offsetY="10"/>
            </effect>

            <!-- CỘT TRÁI: Khung kính tối bán trong suốt xuyên nhẹ thấy sân khấu Gala -->
            <VBox prefWidth="300" spacing="14"
                  style="-fx-background-color: rgba(15, 20, 36, 0.78); -fx-background-radius: 15 0 0 15;">
                <padding>
                    <Insets top="28" right="24" bottom="24" left="24"/>
                </padding>

                <Label text="• NHÓM 10 • LIVE AUCTION"
                       style="-fx-background-color: rgba(241, 196, 15, 0.16); -fx-text-fill: #f1c40f; -fx-border-color: #f1c40f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 5 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                <Label text="ĐÊM ĐẤU GIÁ GALA TRỰC TUYẾN" wrapText="true"
                       style="-fx-text-fill: #fef08a; -fx-font-size: 21px; -fx-font-weight: bold;"/>

                <Label text="Sàn sưu tầm vật phẩm độc bản với cơ chế khớp lệnh thời gian thực và MC dẫn chương trình trực tiếp."
                       wrapText="true"
                       style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px;"/>

                <Separator opacity="0.25"/>

                <VBox spacing="10">
                    <VBox spacing="2" style="-fx-background-color: rgba(255,255,255,0.09); -fx-border-color: rgba(255,255,255,0.14); -fx-border-radius: 10; -fx-padding: 10 12; -fx-background-radius: 10;">
                        <Label text="⚡ Đấu giá Realtime" style="-fx-text-fill: #f1c40f; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Cập nhật giá và cảnh báo vượt giá (Outbid) tức thì." wrapText="true"
                               style="-fx-text-fill: #f1f5f9; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="2" style="-fx-background-color: rgba(255,255,255,0.09); -fx-border-color: rgba(255,255,255,0.14); -fx-border-radius: 10; -fx-padding: 10 12; -fx-background-radius: 10;">
                        <Label text="🛡️ Bảo vệ Anti-Snipe" style="-fx-text-fill: #38bdf8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Tự động gia hạn thêm giờ khi có lượt đặt phút chót." wrapText="true"
                               style="-fx-text-fill: #f1f5f9; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="2" style="-fx-background-color: rgba(255,255,255,0.09); -fx-border-color: rgba(255,255,255,0.14); -fx-border-radius: 10; -fx-padding: 10 12; -fx-background-radius: 10;">
                        <Label text="🤖 Trợ lý Auto-Bid" style="-fx-text-fill: #4ade80; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Tự động nâng giá theo bước giá đến mức trần cài sẵn." wrapText="true"
                               style="-fx-text-fill: #f1f5f9; -fx-font-size: 11px;"/>
                    </VBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="TCP Socket • JavaFX 21 Client"
                       style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;"/>
            </VBox>

            <!-- CỘT PHẢI: Form Đăng nhập / Đăng ký sáng rõ nét -->
            <VBox HBox.hgrow="ALWAYS" spacing="12" alignment="TOP_LEFT"
                  style="-fx-background-color: rgba(255, 255, 255, 0.96); -fx-background-radius: 0 15 15 0;">
                <padding>
                    <Insets top="24" right="30" bottom="24" left="30"/>
                </padding>

                <!-- Thanh chuyển tab Đăng nhập / Đăng ký -->
                <HBox spacing="6" style="-fx-background-color: #e2e8f0; -fx-padding: 4; -fx-background-radius: 10;">
                    <Button fx:id="loginTabBtn" text="Đăng nhập" onAction="#switchToLogin" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="32"
                            style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button fx:id="registerTabBtn" text="Đăng ký" onAction="#switchToRegister" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="32"
                            style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>

                <VBox spacing="3">
                    <Label fx:id="formTitleLabel" text="CHÀO MỪNG TRỞ LẠI"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label fx:id="formSubtitleLabel" text="Đăng nhập để theo dõi và tham gia phiên đấu giá"
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                </VBox>

                <!-- Khung thông báo lỗi hoặc đăng ký thành công -->
                <Label fx:id="feedbackLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
                       style="-fx-padding: 8 12; -fx-background-radius: 8; -fx-font-size: 12px; -fx-font-weight: bold;"/>

                <!-- Tên đăng nhập -->
                <VBox spacing="4">
                    <Label text="Tên đăng nhập" style="-fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <TextField fx:id="usernameField" promptText="Nhập tên tài khoản (vd: bidder1)" prefHeight="38"
                               style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Mật khẩu -->
                <VBox spacing="4">
                    <Label text="Mật khẩu" style="-fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu (tối thiểu 6 ký tự)" prefHeight="38"
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Xác nhận mật khẩu (chỉ hiện khi ở chế độ Đăng ký) -->
                <VBox fx:id="confirmGroup" spacing="4" visible="false" managed="false">
                    <Label text="Xác nhận mật khẩu" style="-fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu để xác nhận" prefHeight="38"
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                    <Label text="Tài khoản đăng ký mới mặc định có vai trò BIDDER."
                           style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                </VBox>

                <!-- Nút hành động chính (nhấn Enter tự kích hoạt) -->
                <Button fx:id="submitButton" text="Đăng nhập vào sàn" onAction="#handleSubmit" defaultButton="true"
                        maxWidth="Infinity" prefHeight="40"
                        style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

                <!-- Khu vực điền nhanh tài khoản Demo -->
                <VBox fx:id="demoQuickBox" spacing="6"
                      style="-fx-background-color: #f8fafc; -fx-padding: 8 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label text="Điền nhanh tài khoản mẫu:" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <HBox spacing="6">
                        <Button text="Bidder 1" onAction="#fillDemoBidder" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="26"
                                style="-fx-background-color: #e0f2fe; -fx-text-fill: #0369a1; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button text="Seller" onAction="#fillDemoSeller" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="26"
                                style="-fx-background-color: #ffedd5; -fx-text-fill: #c2410c; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button text="Admin" onAction="#fillDemoAdmin" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="26"
                                style="-fx-background-color: #f3e8ff; -fx-text-fill: #7e22ce; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER">
                    <Button fx:id="toggleModeButton" text="Chưa có tài khoản? Đăng ký ngay" onAction="#handleToggleMode"
                            style="-fx-background-color: transparent; -fx-text-fill: #1d4ed8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </HBox>
    </StackPane>
</StackPane>