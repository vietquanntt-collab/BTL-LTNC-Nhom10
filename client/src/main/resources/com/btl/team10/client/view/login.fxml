<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="loginRoot" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.btl.team10.client.controller.LoginController"
           style="-fx-background-color: #0e1120;">

    <!-- Lớp 1: Ảnh nền sân khấu Gala toàn màn hình -->
    <Pane fx:id="bgPane" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0" mouseTransparent="true">
        <children>
            <ImageView fx:id="loginBgView" preserveRatio="false"/>
        </children>
    </Pane>

    <!-- Lớp 2: Hạt ánh sáng vàng kim bay lơ lửng tạo chiều sâu không gian -->
    <Pane fx:id="ambientParticlesPane" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0" mouseTransparent="true"/>

    <!-- Lớp 3: Phủ tối viền nhẹ làm nổi bật vùng trung tâm -->
    <Region mouseTransparent="true"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 72%, rgba(10,13,26,0.12), rgba(8,10,20,0.58));"/>

    <!-- Lớp 4: Thẻ Đăng nhập / Đăng ký phong cách Dark Gala Glass -->
    <StackPane alignment="CENTER">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <VBox fx:id="authCardBox" maxWidth="395" maxHeight="455" spacing="13" alignment="TOP_LEFT"
              style="-fx-background-color: rgba(15, 19, 36, 0.88); -fx-background-radius: 18; -fx-border-color: linear-gradient(to bottom right, #fde047, #d97706); -fx-border-width: 1.6; -fx-border-radius: 18;">
            <effect>
                <DropShadow color="rgba(0, 0, 0, 0.72)" radius="32" offsetY="12"/>
            </effect>
            <padding>
                <Insets top="24" right="26" bottom="22" left="26"/>
            </padding>

            <!-- Huy hiệu trạng thái trực tiếp -->
            <HBox alignment="CENTER_LEFT" spacing="7"
                  style="-fx-background-color: rgba(250, 204, 21, 0.12); -fx-border-color: rgba(250, 204, 21, 0.35); -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 4 12;">
                <Circle fx:id="liveStatusDot" radius="4" fill="#4ade80"/>
                <Label text="SÀN ĐẤU GIÁ GALA • TRỰC TUYẾN"
                       style="-fx-text-fill: #fde047; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Thanh chuyển tab Đăng nhập / Đăng ký -->
            <HBox spacing="6" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-padding: 4; -fx-background-radius: 10;">
                <Button fx:id="loginTabBtn" text="Đăng nhập" onAction="#switchToLogin" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="32"
                        style="-fx-background-color: linear-gradient(to right, #f59e0b, #d97706); -fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="registerTabBtn" text="Đăng ký" onAction="#switchToRegister" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="32"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>

            <VBox spacing="3">
                <Label fx:id="formTitleLabel" text="CHÀO MỪNG TRỞ LẠI"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
                <Label fx:id="formSubtitleLabel" text="Đăng nhập để bước vào khán phòng đấu giá trực tiếp"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- Khung thông báo lỗi hoặc đăng ký thành công -->
            <Label fx:id="feedbackLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
                   style="-fx-padding: 8 12; -fx-background-radius: 8; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <!-- Tên đăng nhập -->
            <VBox spacing="4">
                <Label text="Tên đăng nhập" style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Nhập tên tài khoản" prefHeight="38"
                           style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-border-color: rgba(148, 163, 184, 0.35); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Mật khẩu -->
            <VBox spacing="4">
                <Label text="Mật khẩu" style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu (tối thiểu 6 ký tự)" prefHeight="38"
                               style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-border-color: rgba(148, 163, 184, 0.35); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Xác nhận mật khẩu (chỉ hiện khi ở chế độ Đăng ký) -->
            <VBox fx:id="confirmGroup" spacing="4" visible="false" managed="false">
                <Label text="Xác nhận mật khẩu" style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu để xác nhận" prefHeight="38"
                               style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-border-color: rgba(148, 163, 184, 0.35); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                <Label text="Tài khoản đăng ký mới mặc định có vai trò BIDDER."
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Nút hành động chính -->
            <Button fx:id="submitButton" text="Vào Khán Phòng Đấu Giá →" onAction="#handleSubmit" defaultButton="true"
                    maxWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: linear-gradient(to right, #f59e0b, #d97706); -fx-text-fill: #0f172a; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER">
                <Button fx:id="toggleModeButton" text="Chưa có tài khoản? Đăng ký ngay" onAction="#handleToggleMode"
                        style="-fx-background-color: transparent; -fx-text-fill: #fde047; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>