<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="loginRoot" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.btl.team10.client.controller.LoginController"
           stylesheets="@../css/gala-shell.css" styleClass="gala-auth"
           style="-fx-background-color: #fce7f3;">

    <!-- Lớp 1: Ảnh nền ren nơ pastel hồng toàn màn hình -->
    <Pane fx:id="bgPane" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0" mouseTransparent="true">
        <children>
            <ImageView fx:id="loginBgView" preserveRatio="false"/>
        </children>
    </Pane>

    <!-- Lớp 2: Phủ sương hồng kem nhẹ làm nổi bật vật phẩm rơi và thẻ trung tâm -->
    <Region mouseTransparent="true"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 75%, rgba(255,245,248,0.18), rgba(244,114,182,0.28));"/>

    <!-- Lớp 3: 5 vật phẩm nhỏ rơi từ trên xuống (mouseTransparent để không chặn thao tác bấm nút) -->
    <Pane fx:id="ambientParticlesPane" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0" mouseTransparent="true"/>

    <!-- Lớp 4: Thẻ Đăng nhập / Đăng ký -->
    <StackPane alignment="CENTER">
        <padding>
            <Insets top="20" right="28" bottom="20" left="28"/>
        </padding>

        <VBox fx:id="authCardBox" maxWidth="400" maxHeight="-Infinity" spacing="12" alignment="TOP_LEFT"
              style="-fx-background-color: rgba(255, 250, 252, 0.94); -fx-background-radius: 22; -fx-border-color: linear-gradient(to bottom right, #f472b6, #db2777); -fx-border-width: 2; -fx-border-radius: 22;">
            <effect>
                <DropShadow color="rgba(190, 24, 93, 0.24)" radius="28" offsetY="10"/>
            </effect>
            <padding>
                <Insets top="24" right="26" bottom="22" left="26"/>
            </padding>

            <!-- Huy hiệu trạng thái trực tiếp -->
            <HBox alignment="CENTER_LEFT" spacing="7"
                  style="-fx-background-color: #fce7f3; -fx-border-color: #f9a8d4; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 4 12;">
                <Circle fx:id="liveStatusDot" radius="4" fill="#16a34a"/>
                <Label text="PLUSHIE GALA • ĐẤU GIÁ GẤU BÔNG"
                       style="-fx-text-fill: #be185d; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Tiêu đề chào mừng -->
            <VBox spacing="3">
                <Label fx:id="formTitleLabel" text="Chào mừng đến với Plushie Gala"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #4a0e2e;"/>
                <Label fx:id="formSubtitleLabel" wrapText="true"
                       text="Chọn Đăng nhập hoặc Đăng ký bên dưới để bắt đầu."
                       style="-fx-font-size: 12px; -fx-text-fill: #834463;"/>
            </VBox>

            <!-- Hai nút chọn chế độ: luôn hiển thị ngay từ đầu -->
            <HBox spacing="8"
                  style="-fx-background-color: #fdf2f8; -fx-border-color: #fbcfe8; -fx-border-radius: 12; -fx-padding: 5; -fx-background-radius: 12;">
                <Button fx:id="loginTabBtn" text="Đăng nhập" onAction="#switchToLogin"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36"
                        styleClass="button, gala-auth-tab"/>
                <Button fx:id="registerTabBtn" text="Đăng ký" onAction="#switchToRegister"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36"
                        styleClass="button, gala-auth-tab"/>
            </HBox>

            <!-- Khung thông báo lỗi hoặc đăng ký thành công -->
            <Label fx:id="feedbackLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
                   style="-fx-padding: 8 12; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <!-- Khu vực nhập thông tin: ẨN mặc định, chỉ mở ra khi nhấn 1 trong 2 nút trên -->
            <VBox fx:id="formFieldsContainer" spacing="11" visible="false" managed="false">
                <!-- Tên đăng nhập -->
                <VBox spacing="4">
                    <Label text="Tên đăng nhập" style="-fx-text-fill: #6b2146; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <TextField fx:id="usernameField" promptText="Nhập tên tài khoản" prefHeight="36"
                               style="-fx-background-color: #fff5f8; -fx-text-fill: #3b0d24; -fx-prompt-text-fill: #b47b96; -fx-border-color: #f9a8d4; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Mật khẩu -->
                <VBox spacing="4">
                    <Label text="Mật khẩu" style="-fx-text-fill: #6b2146; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu (tối thiểu 6 ký tự)" prefHeight="36"
                                   style="-fx-background-color: #fff5f8; -fx-text-fill: #3b0d24; -fx-prompt-text-fill: #b47b96; -fx-border-color: #f9a8d4; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Xác nhận mật khẩu (chỉ hiện khi chọn Đăng ký) -->
                <VBox fx:id="confirmGroup" spacing="4" visible="false" managed="false">
                    <Label text="Xác nhận mật khẩu" style="-fx-text-fill: #6b2146; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu để xác nhận" prefHeight="36"
                                   style="-fx-background-color: #fff5f8; -fx-text-fill: #3b0d24; -fx-prompt-text-fill: #b47b96; -fx-border-color: #f9a8d4; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 12; -fx-font-size: 13px;"/>
                    <Label text="Tài khoản đăng ký mới mặc định có vai trò BIDDER."
                           style="-fx-text-fill: #834463; -fx-font-size: 11px;"/>
                </VBox>

                <!-- Nút xác nhận gửi biểu mẫu -->
                <Button fx:id="submitButton" text="Đăng nhập" onAction="#handleSubmit" defaultButton="true"
                        maxWidth="Infinity" prefHeight="38"
                        style="-fx-background-color: linear-gradient(to right, #ec4899, #db2777); -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>

                <!-- Nút chuyển nhanh hoặc thu gọn -->
                <HBox alignment="CENTER" spacing="14">
                    <Button fx:id="toggleModeButton" text="Chưa có tài khoản? Đăng ký ngay" onAction="#handleToggleMode"
                            style="-fx-background-color: transparent; -fx-text-fill: #be185d; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Thu gọn" onAction="#collapseForm"
                            style="-fx-background-color: transparent; -fx-text-fill: #834463; -fx-font-size: 11.5px; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</StackPane>