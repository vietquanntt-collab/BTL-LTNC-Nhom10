# Java/Maven
target/
*.class
*.jar
*.log
# The Maven Wrapper JAR is intentionally tracked in .mvn/wrapper so a clean clone can build.
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# Local database and secrets
*.db
*.sqlite
*.sqlite3
.env
config/local.properties
.javafx-cache/

# Keep the runtime database directory in a clean clone; database files stay ignored.
!data/
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# OS
Thumbs.db
Desktop.ini

# SQLite sidecars and locally assembled release
*.db-wal
*.db-shm
*.db-journal
release-bundle/
